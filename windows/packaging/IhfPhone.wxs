<?xml version="1.0" encoding="utf-8"?>
<!--
  IHF Phone for Windows: per-machine x64 MSI (WiX 4). Built by build-msi.ps1, which supplies:
    Version, AppImage (jpackage app image with the native DLLs), Icon, LicenseRtf, BannerBmp, DialogBmp.
  The app files come from AppFiles.wxs, generated by the same script.
  UpgradeCode is the one the earlier jpackage MSIs used (CODE-SPEC), so this replaces them.
  GPL-2.0.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="IHF Phone"
      Manufacturer="IT Hands Free"
      Version="$(var.Version)"
      UpgradeCode="6F2C1A40-8B3E-4D1A-9C55-7E1B0A2D4F18"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="IHF Phone softphone for Windows" Manufacturer="IT Hands Free" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of IHF Phone is already installed."
        AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://ithandsfree.com" />
    <Property Id="ARPHELPLINK" Value="https://ithandsfree.com" />
    <Property Id="ARPCONTACT" Value="IT Hands Free" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="IHF Phone" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuFolder" Name="IT Hands Free" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Component Id="Shortcuts" Directory="MenuFolder" Guid="7C1E9F52-3D8A-4B6E-9A41-2F5D0C8B7E63">
      <Shortcut Id="MenuShortcut" Name="IHF Phone" Description="Calls and texts on your IHF lines"
                Target="[INSTALLFOLDER]IHF Phone.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="IHF Phone"
                Description="Calls and texts on your IHF lines"
                Target="[INSTALLFOLDER]IHF Phone.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\IT Hands Free\IHF Phone" Name="Shortcuts"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="IHF Phone" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <!-- Branded installer: licence page, then the folder page, IHF banner and welcome art. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
  </Package>
</Wix>
